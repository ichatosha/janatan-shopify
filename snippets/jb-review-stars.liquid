{%- comment -%}
  Renders the product's average rating under the price. The rating comes from the
  product's own reviews (custom.reviews metafield); nothing shows without reviews.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.

  Usage:
  {% render 'jb-review-stars', product: product, block: block %}
{%- endcomment -%}

{%- liquid
  assign reviews = product.metafields.custom.reviews.value
  assign reviews_count = 0
  assign reviews_total = 0
  for review in reviews
    assign reviews_count = reviews_count | plus: 1
    assign reviews_total = reviews_total | plus: review.rating.value
  endfor
  assign reviews_sample = false
  if reviews_count == 0 and block.settings.show_sample
    assign reviews_sample = true
    assign reviews_count = 3
    assign reviews_total = 15
  endif
-%}

{%- if reviews_count > 0 -%}
  {%- liquid
    assign reviews_average = reviews_total | times: 1.0 | divided_by: reviews_count | round: 1
    assign reviews_score = reviews_average | remove: '.0'
  -%}
  <div class="hdt-product-info__item" data-type="{{ block.type }}" {{ block.shopify_attributes }}>
    <a class="jb-rating" href="#jb-reviews" aria-label="التقييم {{ reviews_score }} من 5">
      {%- render 'jb-stars', rating: reviews_average, size: 17 -%}
      <span class="jb-rating__score" dir="ltr" aria-hidden="true"><b>{{ reviews_score }}</b><i>/5</i></span>
    </a>
  </div>
  <style>
    .jb-rating { display: inline-flex; align-items: center; gap: 10px; padding: 6px 14px; border: 1px solid rgba(176, 138, 62, .45); border-radius: 40px; background: linear-gradient(180deg, #fffdf8, #f7f2ec); color: #1c1b1a; text-decoration: none; line-height: 1; }
    .jb-rating__score { display: inline-flex; align-items: baseline; gap: 1px; padding-inline-start: 10px; border-inline-start: 1px solid rgba(28, 27, 26, .18); font-family: var(--jb-display, inherit); }
    .jb-rating__score b { font-size: 20px; font-weight: 700; }
    .jb-rating__score i { font-style: normal; font-size: 13px; color: #6b6b6b; }
    .jb-rating:focus-visible { outline: 2px solid #7a0908; outline-offset: 2px; }
  </style>
{%- endif -%}
