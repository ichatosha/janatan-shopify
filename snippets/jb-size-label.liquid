{%- comment -%}
  Splits a size option value like "S (60 :70 KG)" or "ميديم لـ 80 كيلو" into its parts.
  Outputs "name|min|max|label" (weights in kg, 0 when missing), or nothing when the
  option is not a size or no weight is known. Plain letter sizes (S, M, L...) without a
  weight use the store's standard chart.
  Accepts:
  - option_name: {String} option name.
  - value: {String} option value.

  Usage:
  {%- capture size -%}{%- render 'jb-size-label', option_name: option.name, value: value -%}{%- endcapture -%}
{%- endcomment -%}
{%- liquid
  assign jb_option = option_name | downcase | strip
  assign jb_is_size = false
  case jb_option
    when 'size', 'sizes', 'مقاس', 'المقاس', 'مقاسات', 'المقاسات'
      assign jb_is_size = true
  endcase

  assign jb_min = 0
  assign jb_max = 0
  if jb_is_size
    assign jb_text = value | append: '' | replace: '٠', '0' | replace: '١', '1' | replace: '٢', '2' | replace: '٣', '3' | replace: '٤', '4' | replace: '٥', '5' | replace: '٦', '6' | replace: '٧', '7' | replace: '٨', '8' | replace: '٩', '9'
    assign jb_name = jb_text | split: '(' | first | split: ':' | first | split: 'مناسب' | first | split: 'حتى' | first | split: 'لحد' | first | split: ' لـ' | first | split: ' ل ' | first | strip
    assign jb_tokens = jb_text | downcase | replace: '(', ' ' | replace: ')', ' ' | replace: ':', ' ' | replace: '-', ' ' | replace: 'kg', ' ' | replace: 'كيلو', ' ' | replace: 'كجم', ' ' | split: ' '
    for jb_token in jb_tokens
      assign jb_number = jb_token | plus: 0
      if jb_number >= 30
        assign jb_min = jb_max
        assign jb_max = jb_number
      endif
    endfor
    if jb_name == blank
      assign jb_name = 'مقاس واحد'
    endif
    if jb_max == 0
      assign jb_letter = jb_name | upcase
      case jb_letter
        when 'XS'
          assign jb_min = 50
          assign jb_max = 55
        when 'S'
          assign jb_min = 60
          assign jb_max = 70
        when 'M'
          assign jb_min = 70
          assign jb_max = 80
        when 'L'
          assign jb_min = 80
          assign jb_max = 90
        when 'XL'
          assign jb_min = 90
          assign jb_max = 105
        when 'XXL', '2XL'
          assign jb_min = 105
          assign jb_max = 120
      endcase
    endif
  endif
-%}
{%- if jb_max > 0 -%}
  {{- jb_name }}|{{ jb_min }}|{{ jb_max }}|{% if jb_min > 0 %}{{ jb_min }}-{{ jb_max }} كجم{% else %}حتى {{ jb_max }} كجم{% endif -%}
{%- endif -%}
