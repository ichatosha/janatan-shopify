{%- comment -%}
  Styles and behaviour shared by the horizontal scroll strips (jb-product-strip and
  jb-category-strip sections).

  Usage:
  {% render 'jb-strip-assets' %}
{%- endcomment -%}

<style>
  .jb-strip { display: block; color: var(--jb-ink, #1c1b1a); }
  .jb-strip__head { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; margin-bottom: 18px; padding-bottom: 12px; border-bottom: 1px solid var(--jb-line, rgba(28, 27, 26, .14)); }
  .jb-strip__heading { margin: 0; font-family: var(--jb-display, inherit); font-size: 26px; font-weight: 700; line-height: 1.3; }
  .jb-strip__tools { display: flex; align-items: center; gap: 8px; }
  .jb-strip__all { font-size: 13px; font-weight: 600; color: var(--jb-brand, #7a0908); text-decoration: none; border-bottom: 1px solid currentColor; padding-bottom: 1px; white-space: nowrap; }
  .jb-strip__arrow { display: none; width: 40px; height: 40px; border: 1px solid var(--jb-line, rgba(28, 27, 26, .3)); border-radius: 50%; background: #fff; color: var(--jb-ink, #1c1b1a); font-size: 18px; line-height: 1; cursor: pointer; transition: background .2s ease, color .2s ease; }
  .jb-strip__arrow:not([disabled]):hover { background: var(--jb-ink, #1c1b1a); color: #fff; }
  .jb-strip__arrow:focus-visible, .jb-strip__all:focus-visible, .jb-strip a:focus-visible { outline: 2px solid var(--jb-brand, #7a0908); outline-offset: 2px; }
  .jb-strip__arrow[disabled] { opacity: .35; cursor: default; }
  .jb-strip__track { position: relative; display: flex; gap: 12px; margin: 0; padding: 2px 2px 10px; list-style: none; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .jb-strip__track::-webkit-scrollbar { display: none; }
  .jb-strip__item { position: relative; flex: 0 0 44%; scroll-snap-align: start; min-width: 0; }
  @media (min-width: 768px) {
    .jb-strip__heading { font-size: 34px; }
    .jb-strip__arrow { display: inline-grid; place-items: center; }
    .jb-strip__track { gap: 20px; }
    .jb-strip__item { flex-basis: calc(25% - 15px); }
  }
  @media (prefers-reduced-motion: reduce) { .jb-strip__track { scroll-behavior: auto; } }

  .jb-pcard { display: flex; flex-direction: column; height: 100%; color: inherit; text-align: center; }
  .jb-pcard a { color: inherit; text-decoration: none; }
  .jb-pcard__frame { position: relative; }
  .jb-pcard__media { position: relative; display: block; aspect-ratio: 2 / 3; border-radius: 4px; overflow: hidden; background: var(--jb-ivory, #f7f2ec); }
  .jb-pcard__media img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: transform .6s ease; }
  .jb-pcard__media:hover img { transform: scale(1.04); }
  .jb-pcard__tag { position: absolute; top: 8px; inset-inline-start: 8px; padding: 2px 10px; border-radius: 40px; background: var(--jb-brand, #7a0908); color: #fff; font-size: 12px; font-weight: 600; line-height: 1.6; }
  .jb-pcard__title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: 10px 0 4px; font-size: 14px; line-height: 1.5; min-height: 3em; }
  .jb-pcard__cta { margin-top: auto; padding-top: 10px; }
  .jb-pcard__cta > * { display: block; }
  .jb-pcard__cta form { display: block; }
  .jb-pcard__add { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; min-height: 40px; padding: 6px 10px; border: 1px solid var(--jb-ink, #1c1b1a); border-radius: 4px; background: #fff; color: var(--jb-ink, #1c1b1a) !important; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; transition: background .2s ease, color .2s ease; }
  .jb-pcard__add:hover { background: var(--jb-ink, #1c1b1a); color: #fff !important; }
  .jb-pcard__add svg { flex: 0 0 auto; }
  @media (prefers-reduced-motion: reduce) { .jb-pcard__media img { transition: none; } }
</style>

<script>
  if (!customElements.get('jb-strip')) {
    customElements.define('jb-strip', class extends HTMLElement {
      connectedCallback() {
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => this.init(), { once: true });
        else this.init();
      }

      init() {
        this.track = this.querySelector('.jb-strip__track');
        this.prev = this.querySelector('[data-strip="prev"]');
        this.next = this.querySelector('[data-strip="next"]');
        if (!this.prev || !this.next) return;
        this.direction = getComputedStyle(this.track).direction === 'rtl' ? -1 : 1;
        this.prev.addEventListener('click', () => this.move(-1));
        this.next.addEventListener('click', () => this.move(1));
        this.track.addEventListener('scroll', () => this.update(), { passive: true });
        this.update();
      }

      move(step) {
        this.track.scrollBy({ left: step * this.direction * this.track.clientWidth * 0.8 });
      }

      update() {
        const scrolled = Math.abs(this.track.scrollLeft);
        const max = this.track.scrollWidth - this.track.clientWidth;
        this.prev.disabled = scrolled < 4;
        this.next.disabled = scrolled > max - 4;
      }
    });
  }
</script>
