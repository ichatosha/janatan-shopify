{%- comment -%}
  Renders the floating WhatsApp button. The number comes from the theme's WhatsApp
  social link.

  Usage (once, at the end of the layout body):
  {% render 'jb-whatsapp' %}
{%- endcomment -%}

{%- if settings.social_whatsapp_link != blank -%}
<a class="jb-wa" href="{{ settings.social_whatsapp_link }}" target="_blank" rel="noopener noreferrer" aria-label="تواصلي معنا على واتساب">
  <svg viewBox="0 0 32 32" width="26" height="26" fill="currentColor" aria-hidden="true"><path d="M16.02 3.2C8.96 3.2 3.22 8.93 3.22 15.98c0 2.25.59 4.45 1.71 6.39L3.1 28.8l6.6-1.73a12.78 12.78 0 0 0 6.31 1.66h.01c7.05 0 12.79-5.73 12.79-12.78 0-3.42-1.33-6.63-3.75-9.04a12.7 12.7 0 0 0-9.04-3.71zm0 23.37h-.01c-1.91 0-3.78-.51-5.41-1.48l-.39-.23-3.92 1.03 1.05-3.82-.25-.39a10.6 10.6 0 0 1-1.63-5.7c0-5.86 4.77-10.62 10.63-10.62 2.84 0 5.5 1.11 7.51 3.11a10.55 10.55 0 0 1 3.11 7.52c0 5.86-4.77 10.58-10.69 10.58zm5.83-7.95c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.72.16-.21.32-.82 1.04-1.01 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59a9.63 9.63 0 0 1-1.78-2.21c-.19-.32-.02-.49.14-.65.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.72-1.73-.98-2.37-.26-.62-.52-.54-.72-.55l-.61-.01c-.21 0-.56.08-.85.4-.29.32-1.12 1.09-1.12 2.66s1.14 3.09 1.3 3.3c.16.21 2.25 3.43 5.45 4.81.76.33 1.36.53 1.82.67.76.24 1.46.21 2.01.13.61-.09 1.89-.77 2.16-1.52.27-.75.27-1.39.19-1.52-.08-.13-.29-.21-.61-.37z"/></svg>
</a>

<style>
  .jb-wa { position: fixed; z-index: 90; right: 16px; bottom: 84px; display: grid; place-items: center; width: 50px; height: 50px; border-radius: 50%; background: #25d366; color: #fff; box-shadow: 0 6px 18px rgba(0, 0, 0, .22); transition: transform .2s ease; }
  .jb-wa::before { content: ""; position: absolute; inset: 0; z-index: -1; border-radius: 50%; background: #25d366; animation: jb-wa-pulse 2.4s ease-out infinite; }
  .jb-wa:hover { transform: scale(1.06); color: #fff; }
  .jb-wa:focus-visible { outline: 2px solid #1c1b1a; outline-offset: 3px; }
  @keyframes jb-wa-pulse {
    0% { transform: scale(1); opacity: .55; }
    70%, 100% { transform: scale(1.7); opacity: 0; }
  }
  @media (min-width: 1150px) { .jb-wa { bottom: 24px; right: 24px; } }
  @media (prefers-reduced-motion: reduce) { .jb-wa, .jb-wa::before { animation: none; transition: none; } }
</style>
{%- endif -%}
