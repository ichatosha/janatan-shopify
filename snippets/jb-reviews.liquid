{%- comment -%}
  Renders the product's own customer reviews: name, stars, text and an optional chat
  screenshot that opens full size. Reviews are entered in Shopify admin on the product
  (custom.reviews metafield, "Customer review" entries); nothing shows without reviews.
  Accepts:
  - product: {Object} product object.
  - block: {Object} passing the block information.

  Usage:
  {% render 'jb-reviews', product: product, block: block %}
{%- endcomment -%}

{%- liquid
  assign reviews = product.metafields.custom.reviews.value
  assign reviews_count = 0
  assign reviews_total = 0
  for review in reviews
    assign reviews_count = reviews_count | plus: 1
    assign reviews_total = reviews_total | plus: review.rating.value
  endfor
  assign reviews_sample = false
  if reviews_count == 0 and block.settings.show_sample
    assign reviews_sample = true
    assign reviews_count = 3
    assign reviews_total = 15
  endif
  assign reviews_visible = block.settings.visible_count
-%}

{%- if reviews_count > 0 -%}
{%- assign reviews_average = reviews_total | times: 1.0 | divided_by: reviews_count | round: 1 -%}
<div class="hdt-product-info__item" data-type="{{ block.type }}" {{ block.shopify_attributes }}>
  <jb-reviews class="jb-reviews" id="jb-reviews">
    <div class="jb-reviews__head">
      <h2 class="jb-reviews__heading">{{ block.settings.heading }}</h2>
      <div class="jb-reviews__summary">
        <span class="jb-reviews__average">{{ reviews_average }}</span>
        {%- render 'jb-stars', rating: reviews_average, size: 18 -%}
        <span class="jb-reviews__count">{% if reviews_count == 1 %}رأي واحد{% elsif reviews_count == 2 %}رأيين{% elsif reviews_count > 10 %}{{ reviews_count }} رأي{% else %}{{ reviews_count }} آراء{% endif %}</span>
      </div>
    </div>

    <ul class="jb-reviews__list" role="list">
      {%- if reviews_sample -%}
        {%- for sample in (1..3) -%}
          <li class="jb-reviews__item">
            <div class="jb-reviews__top">
              <span class="jb-reviews__name">اسم العميلة</span>
              <span class="jb-reviews__sample">نموذج</span>
              {%- render 'jb-stars', rating: 5, size: 14 -%}
            </div>
            <p class="jb-reviews__text">هنا يظهر نص رأي العميلة، ومعه صورة المحادثة لو أضفتيها من لوحة التحكم.</p>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for review in reviews -%}
          <li class="jb-reviews__item"{% if forloop.index > reviews_visible %} hidden data-more{% endif %}>
            <div class="jb-reviews__top">
              <span class="jb-reviews__name">{{ review.name.value | escape }}</span>
              {%- if review.date.value != blank -%}<time class="jb-reviews__date" datetime="{{ review.date.value | date: '%Y-%m-%d' }}">{{ review.date.value | date: '%d/%m/%Y' }}</time>{%- endif -%}
              {%- render 'jb-stars', rating: review.rating.value, size: 14 -%}
            </div>
            {%- if review.text.value != blank -%}
              <p class="jb-reviews__text">{{ review.text.value | escape | newline_to_br }}</p>
            {%- endif -%}
            {%- if review.screenshot.value != blank -%}
              <button type="button" class="jb-reviews__shot" data-full="{{ review.screenshot.value | image_url: width: 1200 }}" aria-label="افتحي الصورة المرفقة مع رأي {{ review.name.value | escape }}">
                <img src="{{ review.screenshot.value | image_url: width: 200 }}" alt="" loading="lazy" width="100" height="100">
                <span>عرض الصورة</span>
              </button>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- if reviews_sample == false and reviews_count > reviews_visible -%}
      <button type="button" class="jb-reviews__more">عرض كل الآراء ({{ reviews_count }})</button>
    {%- endif -%}

    <dialog class="jb-reviews__dialog" aria-label="الصورة المرفقة">
      <button type="button" class="jb-reviews__close" aria-label="إغلاق">×</button>
      <img alt="الصورة المرفقة مع الرأي">
    </dialog>
  </jb-reviews>
</div>

<style>
  .jb-reviews { display: block; padding-top: 18px; border-top: 1px solid rgba(58, 59, 61, .18); color: #000; scroll-margin-top: 110px; }
  .jb-reviews__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; margin-bottom: 12px; }
  .jb-reviews__heading { margin: 0; font-size: 18px; font-weight: 700; line-height: 1.4; }
  .jb-reviews__summary { display: flex; align-items: center; gap: 8px; }
  .jb-reviews__average { font-size: 22px; font-weight: 700; line-height: 1; }
  .jb-reviews__count { font-size: 13px; color: #545454; }
  .jb-reviews__list { display: grid; gap: 10px; margin: 0; padding: 0; list-style: none; }
  .jb-reviews__item { padding: 12px 14px; border-radius: 6px; background: #f2f2f2; }
  .jb-reviews__item[hidden] { display: none; }
  .jb-reviews__top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; }
  .jb-reviews__name { font-weight: 700; font-size: 14px; }
  .jb-reviews__date { font-size: 12px; color: #545454; }
  .jb-reviews__top > span[role="img"] { margin-inline-start: auto; }
  .jb-reviews__sample { padding: 1px 8px; border-radius: 40px; background: #3a3b3d; color: #fff; font-size: 11px; }
  .jb-reviews__text { margin: 8px 0 0; font-size: 14px; line-height: 1.7; }
  .jb-reviews__shot { display: inline-flex; align-items: center; gap: 10px; margin-top: 10px; padding: 4px; padding-inline-end: 12px; border: 1px solid rgba(58, 59, 61, .25); border-radius: 6px; background: #fff; color: #3a3b3d; font: inherit; font-size: 13px; font-weight: 600; cursor: pointer; }
  .jb-reviews__shot img { width: 52px; height: 52px; border-radius: 4px; object-fit: cover; display: block; }
  .jb-reviews__shot:focus-visible, .jb-reviews__more:focus-visible, .jb-reviews__close:focus-visible { outline: 2px solid #3a3b3d; outline-offset: 2px; }
  .jb-reviews__more { width: 100%; min-height: 44px; margin-top: 12px; border: 1px solid #3a3b3d; border-radius: 5px; background: #fff; color: #3a3b3d; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }
  .jb-reviews__dialog { max-width: min(92vw, 520px); max-height: 90vh; padding: 0; border: 0; border-radius: 8px; background: #fff; overflow: auto; }
  .jb-reviews__dialog::backdrop { background: rgba(0, 0, 0, .7); }
  .jb-reviews__dialog img { display: block; width: 100%; height: auto; }
  .jb-reviews__close { position: sticky; top: 8px; float: inline-end; margin: 8px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: rgba(0, 0, 0, .65); color: #fff; font-size: 24px; line-height: 1; cursor: pointer; z-index: 1; }
</style>

<script>
  if (!customElements.get('jb-reviews')) {
    customElements.define('jb-reviews', class extends HTMLElement {
      connectedCallback() {
        const dialog = this.querySelector('.jb-reviews__dialog');
        const more = this.querySelector('.jb-reviews__more');
        this.addEventListener('click', (event) => {
          const shot = event.target.closest('.jb-reviews__shot');
          if (shot) {
            dialog.querySelector('img').src = shot.dataset.full;
            dialog.showModal();
          } else if (event.target.closest('.jb-reviews__close') || event.target === dialog) {
            dialog.close();
          }
        });
        if (more) {
          more.addEventListener('click', () => {
            this.querySelectorAll('[data-more]').forEach((item) => { item.hidden = false; });
            more.remove();
          });
        }
      }
    });
  }
</script>
{%- endif -%}
