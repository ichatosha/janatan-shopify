{%- comment -%}
  Renders a weight based size finder. The weight ranges come from the product's own
  size option values. It only shows when the product has more than one size to pick from.
  Accepts:
  - product: {Object} product object.

  Usage:
  {% render 'jb-size-finder', product: product %}
{%- endcomment -%}

{%- liquid
  assign finder_count = 0
  assign finder_position = 0
  for option in product.options_with_values
    for value in option.values
      capture finder_size
        render 'jb-size-label', option_name: option.name, value: value
      endcapture
      assign finder_size = finder_size | strip
      if finder_size != blank
        assign finder_count = finder_count | plus: 1
        assign finder_position = option.position
      endif
    endfor
  endfor
-%}

{%- if finder_count > 1 and product.available -%}
  <jb-size-finder class="jb-finder">
    <button type="button" class="jb-fit-button jb-fit-button--solid jb-finder__open">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 13l3-4M9 3h6"/></svg>
      <span class="jb-finder__open-text">اعرفي مقاسك</span>
    </button>

    <dialog class="jb-finder__dialog" aria-labelledby="jb-finder-title-{{ product.id }}">
      <div class="jb-finder__head">
        <h2 class="jb-finder__title" id="jb-finder-title-{{ product.id }}">اعرفي مقاسك</h2>
        <button type="button" class="jb-finder__close" aria-label="إغلاق">×</button>
      </div>
      <p class="jb-finder__lead">اكتبي وزنك، ونختار لك المقاس المناسب من مقاسات هذا المنتج.</p>
      <label class="jb-finder__label" for="jb-finder-weight-{{ product.id }}">الوزن بالكيلو</label>
      <div class="jb-finder__row">
        <input class="jb-finder__input" id="jb-finder-weight-{{ product.id }}" type="number" inputmode="numeric" min="30" max="200" placeholder="مثلاً 65" autocomplete="off">
        <button type="button" class="jb-finder__button">اعرفي مقاسي</button>
      </div>
      <div class="jb-finder__result" role="status" hidden></div>
      <button type="button" class="jb-finder__done" hidden>تمام</button>
    </dialog>
    <script type="application/json">
      {
        "position": {{ finder_position }},
        "sizes": [
          {%- assign finder_first = true -%}
          {%- for option in product.options_with_values -%}
            {%- if option.position == finder_position -%}
              {%- for value in option.values -%}
                {%- capture finder_size -%}{%- render 'jb-size-label', option_name: option.name, value: value -%}{%- endcapture -%}
                {%- assign finder_parts = finder_size | strip | split: '|' -%}
                {%- if finder_parts.size == 4 -%}
                  {%- unless finder_first -%},{%- endunless -%}
                  {%- assign finder_first = false -%}
                  { "value": {{ value | append: '' | json }}, "name": {{ finder_parts[0] | json }}, "min": {{ finder_parts[1] }}, "max": {{ finder_parts[2] }}, "label": {{ finder_parts[3] | json }} }
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
  </jb-size-finder>

<style>
  .jb-finder { display: contents; }
  .jb-finder__dialog { width: min(92vw, 400px); padding: 20px; border: 0; border-radius: 10px; background: #fff; color: #1c1b1a; text-align: start; }
  .jb-finder__dialog::backdrop { background: rgba(20, 12, 10, .6); }
  .jb-finder__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .jb-finder__title { margin: 0; font-family: var(--jb-display, inherit); font-size: 26px; font-weight: 700; line-height: 1.3; }
  .jb-finder__close { flex: 0 0 40px; width: 40px; height: 40px; border: 0; border-radius: 50%; background: #f7f2ec; color: #1c1b1a; font-size: 24px; line-height: 1; cursor: pointer; }
  .jb-finder__lead { margin: 6px 0 16px; font-size: 14px; line-height: 1.7; color: #545454; }
  .jb-finder__label { display: block; margin: 0 0 6px; font-size: 13px; font-weight: 600; }
  .jb-finder__row { display: flex; gap: 8px; }
  .jb-finder__input { flex: 1 1 auto; min-width: 0; min-height: 48px; padding: 4px 14px; border: 1px solid rgba(28, 27, 26, .35); border-radius: 6px; background: #fff; color: #1c1b1a; font: inherit; font-size: 18px; }
  .jb-finder__button, .jb-finder__done { min-height: 48px; padding: 4px 18px; border: 1px solid #7a0908; border-radius: 6px; background: #7a0908; color: #fff; font: inherit; font-size: 15px; font-weight: 700; cursor: pointer; white-space: nowrap; }
  .jb-finder__done { width: 100%; margin-top: 12px; background: #1c1b1a; border-color: #1c1b1a; }
  .jb-finder__input:focus-visible, .jb-finder__button:focus-visible, .jb-finder__done:focus-visible, .jb-finder__close:focus-visible { outline: 2px solid #7a0908; outline-offset: 2px; }
  .jb-finder__result { margin-top: 14px; font-size: 14px; line-height: 1.7; color: #545454; }
  .jb-finder__result.is-size { display: grid; justify-items: center; gap: 2px; padding: 16px; border: 1px solid #7a0908; border-radius: 8px; background: #fbf3f3; color: #1c1b1a; text-align: center; }
  .jb-finder__result.is-size b { color: #7a0908; font-size: 44px; font-weight: 700; line-height: 1.15; }
  .jb-finder__result.is-size small { font-size: 14px; font-weight: 600; color: #545454; }
</style>

<script>
  if (!customElements.get('jb-size-finder')) {
    customElements.define('jb-size-finder', class extends HTMLElement {
      connectedCallback() {
        if (this.ready) return;
        this.ready = true;
        this.data = JSON.parse(this.querySelector('script[type="application/json"]').textContent);
        this.data.sizes.sort((a, b) => a.max - b.max);
        this.dialog = this.querySelector('.jb-finder__dialog');
        this.input = this.querySelector('.jb-finder__input');
        this.result = this.querySelector('.jb-finder__result');
        this.done = this.querySelector('.jb-finder__done');
        this.openText = this.querySelector('.jb-finder__open-text');
        this.querySelector('.jb-finder__open').addEventListener('click', () => this.dialog.showModal());
        this.querySelector('.jb-finder__button').addEventListener('click', () => this.find());
        this.done.addEventListener('click', () => this.dialog.close());
        this.dialog.addEventListener('click', (event) => {
          if (event.target === this.dialog || event.target.closest('.jb-finder__close')) this.dialog.close();
        });
        this.input.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter') return;
          event.preventDefault();
          this.find();
        });
      }

      find() {
        const weight = parseFloat(this.input.value);
        this.result.hidden = false;
        this.result.textContent = '';
        this.result.classList.remove('is-size');
        this.done.hidden = true;
        if (!weight || weight < 30 || weight > 200) {
          this.result.textContent = 'اكتبي وزنك بالكيلو، مثلاً 65.';
          return;
        }
        const size = this.data.sizes.find((item) => weight <= item.max);
        if (!size) {
          const largest = this.data.sizes[this.data.sizes.length - 1];
          this.result.textContent = 'أكبر مقاس متاح (' + largest.name + ') مناسب حتى ' + largest.max + ' كجم.';
          return;
        }
        const smallest = this.data.sizes[0];
        if (size === smallest && smallest.min && weight < smallest.min) {
          this.result.textContent = 'أصغر مقاس متاح (' + smallest.name + ') مناسب من ' + smallest.min + ' كجم.';
          return;
        }
        const name = document.createElement('b');
        name.textContent = size.name;
        const range = document.createElement('small');
        range.textContent = size.label;
        this.result.classList.add('is-size');
        this.result.append('مقاسك المناسب', name, range);
        this.done.hidden = false;
        this.done.textContent = 'تمام، اختاري ' + size.name;
        this.openText.textContent = 'مقاسك ' + size.name;
        this.select(size.value);
      }

      /* Picks the size in the theme picker and tells the bundle picker about it. */
      select(value) {
        const scope = this.closest('.shopify-section') || document;
        const input = Array.from(scope.querySelectorAll('.hdt-product__variant-picker input[type="radio"]')).find((radio) => radio.value === value);
        if (input && !input.checked) input.click();
        document.dispatchEvent(new CustomEvent('jb:size', { detail: { position: this.data.position, value } }));
      }
    });
  }
</script>
{%- endif -%}
