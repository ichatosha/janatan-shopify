{%- comment -%}
  Renders the extras under a product card's price: the average rating of the product's
  own reviews (when it has any) and a dot per available colour.
  Accepts:
  - product: {Object} product object.

  Usage:
  {% render 'jb-card-extras', product: product %}
{%- endcomment -%}

{%- liquid
  assign extras_reviews = product.metafields.custom.reviews.value
  assign extras_count = 0
  assign extras_total = 0
  for extras_review in extras_reviews
    assign extras_count = extras_count | plus: 1
    assign extras_total = extras_total | plus: extras_review.rating.value
  endfor
  assign extras_max = 6
-%}

{%- if extras_count > 0 -%}
  {%- assign extras_average = extras_total | times: 1.0 | divided_by: extras_count | round: 1 -%}
  <div style="margin-top:4px;font-size:12px;line-height:1.4;color:#545454">
    {%- render 'jb-stars', rating: extras_average, size: 13 -%}
    <span style="margin-inline-start:4px">({{ extras_count }})</span>
  </div>
{%- endif -%}

{%- for extras_option in product.options_with_values -%}
  {%- capture extras_dots -%}
    {%- assign extras_shown = 0 -%}
    {%- assign extras_hidden = 0 -%}
    {%- for extras_value in extras_option.values -%}
      {%- unless extras_value.available -%}{%- continue -%}{%- endunless -%}
      {%- capture extras_bg -%}{%- render 'jb-color-swatch', option_name: extras_option.name, option_position: extras_option.position, value: extras_value, product: product -%}{%- endcapture -%}
      {%- assign extras_bg = extras_bg | strip -%}
      {%- if extras_bg == blank -%}{%- continue -%}{%- endif -%}
      {%- if extras_shown < extras_max -%}
        {%- assign extras_shown = extras_shown | plus: 1 -%}
        <span title="{{ extras_value | escape }}" style="display:inline-block;width:14px;height:14px;border-radius:50%;border:1px solid #fff;box-shadow:0 0 0 1px rgba(0,0,0,.25);background:{{ extras_bg }}"></span>
      {%- else -%}
        {%- assign extras_hidden = extras_hidden | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if extras_hidden > 0 -%}<span style="font-size:11px;line-height:14px;color:#545454">+{{ extras_hidden }}</span>{%- endif -%}
  {%- endcapture -%}
  {%- assign extras_dots = extras_dots | strip -%}
  {%- if extras_dots != blank -%}
    <div role="img" aria-label="الألوان المتاحة" style="display:inline-flex;flex-wrap:wrap;align-items:center;gap:5px;margin-top:6px;padding:1px">{{ extras_dots }}</div>
  {%- endif -%}
{%- endfor -%}
