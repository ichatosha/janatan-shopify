{%- comment -%}
  Care instructions as a row of laundry symbols with a short line under each.
{%- endcomment -%}

{%- liquid
  comment
    Care lines per fabric, picked from the product's name. Format: symbol|text, lines separated by ";".
    Products whose fabric is not recognised fall back to the blocks set in the theme editor.
  endcomment
  assign care_fabric = ''
  assign care_lines = ''
  if product != blank
    if product.title contains 'ساتان' or product.description contains 'شميز ستان'
      assign care_fabric = 'ساتان'
      assign care_lines = 'hand|غسيل يدوي أو دورة هادئة بماء بارد;bleach|بدون مبيّض;iron1|كيّ من الظهر على حرارة منخفضة;tumble|بدون تنشيف آلي;line|تجفيف على الشماعة'
    elsif product.title contains 'جينز'
      assign care_fabric = 'جينز'
      assign care_lines = 'wash30|غسيل بماء بارد والقطعة مقلوبة;bleach|بدون مبيّض;iron2|كيّ من الظهر على حرارة متوسطة;tumblelow|تنشيف آلي على حرارة متوسطة;line|أو تجفيف على الحبل'
    elsif product.title contains 'كتان'
      assign care_fabric = 'كتان'
      assign care_lines = 'wash30|غسيل بماء بارد;bleach|بدون مبيّض;iron3|كيّ على حرارة عالية والقطعة رطبة;tumblelow|تنشيف آلي على حرارة منخفضة;line|أو تجفيف على الحبل'
    elsif product.title contains 'بوبلين'
      assign care_fabric = 'بوبلين قطن'
      assign care_lines = 'wash30|غسيل بماء بارد على دورة هادئة;bleach|بدون مبيّض;iron2|كيّ من الظهر على حرارة متوسطة;tumblelow|تنشيف آلي على حرارة منخفضة;line|أو تجفيف على الحبل'
    elsif product.title contains 'روزالين' or product.title contains 'سوفت'
      assign care_fabric = 'بوليستر'
      assign care_lines = 'wash40|غسيل على 40 درجة;bleach|بدون مبيّض;iron1|كيّ على حرارة منخفضة;tumblelow|تنشيف آلي على حرارة منخفضة;line|أو تجفيف على الحبل'
    endif
  endif
  assign care_lines = care_lines | split: ';'
-%}

{%- if section.blocks.size > 0 or care_lines.size > 0 -%}
<div class="hdt-container" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="jb-care">
    <div class="jb-heading">
      {%- if section.settings.eyebrow != blank -%}<p class="jb-eyebrow" dir="ltr">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="jb-heading__title">{{ section.settings.heading }}</h2>
    </div>
    <ul class="jb-care__list" role="list">
      {%- if care_lines.size > 0 -%}
        {%- for care_line in care_lines -%}
          {%- assign care_parts = care_line | split: '|' -%}
          <li class="jb-care__item">
            <span class="jb-care__icon" aria-hidden="true">{%- render 'jb-care-icon', icon: care_parts[0] -%}</span>
            <span class="jb-care__text">{{ care_parts[1] }}</span>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks -%}
          <li class="jb-care__item" {{ block.shopify_attributes }}>
            <span class="jb-care__icon" aria-hidden="true">{%- render 'jb-care-icon', icon: block.settings.icon -%}</span>
            <span class="jb-care__text">{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if section.settings.note != blank -%}<p class="jb-care__note">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</div>

<style>
  .jb-care { padding: 28px 16px; border: 1px solid var(--jb-line); border-radius: 6px; background: var(--jb-ivory); color: var(--jb-ink); }
  .jb-care .jb-heading { margin-bottom: 20px; }
  .jb-care .jb-heading__title { font-size: 26px; }
  .jb-care__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 8px; margin: 0; padding: 0; list-style: none; }
  .jb-care__item { display: grid; gap: 8px; justify-items: center; text-align: center; }
  .jb-care__icon { display: grid; place-items: center; width: 64px; height: 64px; border: 1px solid var(--jb-brand); border-radius: 50%; background: #fff; color: var(--jb-brand); }
  .jb-care__text { font-size: 12px; font-weight: 600; line-height: 1.6; max-width: 16ch; }
  .jb-care__note { margin: 20px 0 0; font-size: 12px; line-height: 1.7; color: #545454; text-align: center; }
  @media (min-width: 768px) {
    .jb-care { padding: 40px 32px; }
    .jb-care__list { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .jb-care__text { font-size: 13px; }
    .jb-care .jb-heading__title { font-size: 32px; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Care instructions",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above the heading", "default": "CARE GUIDE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "إرشادات العناية" },
    { "type": "text", "id": "note", "label": "Note under the symbols" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 8 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 }
  ],
  "blocks": [
    {
      "type": "care",
      "name": "Instruction",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Symbol",
          "options": [
            { "value": "wash", "label": "Machine wash 30" },
            { "value": "hand", "label": "Hand wash" },
            { "value": "bleach", "label": "Do not bleach" },
            { "value": "iron", "label": "Iron on low heat" },
            { "value": "tumble", "label": "Do not tumble dry" },
            { "value": "shade", "label": "Dry in the shade" }
          ],
          "default": "wash"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "غسيل على 30 درجة" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Care instructions" }
  ]
}
{% endschema %}
