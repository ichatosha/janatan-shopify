{%- comment -%}
  The brand story: a tall photograph beside the text on desktop, the text laid over the
  photograph on mobile.
{%- endcomment -%}

{%- liquid
  assign feature_image = section.settings.image
  if feature_image == blank and section.settings.collection != blank
    assign feature_image = section.settings.collection.products.first.featured_image
  endif
-%}

<div class="jb-feature" style="margin-top:{{ section.settings.padding_top }}px;margin-bottom:{{ section.settings.padding_bottom }}px">
  <div class="jb-feature__media">
    {%- if feature_image -%}
      {{ feature_image | image_url: width: 1400 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', widths: '480, 720, 960, 1200, 1400', alt: '' }}
    {%- endif -%}
  </div>
  <div class="jb-feature__body">
    {%- if section.settings.eyebrow != blank -%}<p class="jb-eyebrow" dir="ltr">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="jb-feature__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="jb-feature__text">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="jb-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

<style>
  .jb-feature { position: relative; display: grid; background: var(--jb-ink); color: #fff; overflow: hidden; }
  .jb-feature__media { grid-area: 1 / 1; min-height: 560px; }
  .jb-feature__media img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
  .jb-feature__body { grid-area: 1 / 1; z-index: 1; align-self: end; display: grid; gap: 14px; justify-items: start; padding: 120px 20px 32px; background: linear-gradient(to top, rgba(20, 12, 10, .92) 0%, rgba(20, 12, 10, .7) 55%, rgba(20, 12, 10, 0) 100%); }
  .jb-feature .jb-eyebrow { color: #e9dfd3; }
  .jb-feature .jb-eyebrow::before { background: #e9dfd3; }
  .jb-feature__title { margin: 0; font-family: var(--jb-display); font-size: 34px; font-weight: 700; line-height: 1.35; color: inherit; }
  .jb-feature__text { font-size: 15px; line-height: 1.9; opacity: .92; }
  .jb-feature__text p { margin: 0 0 10px; }
  .jb-feature__text p:last-child { margin-bottom: 0; }
  .jb-feature .jb-button { margin-top: 6px; background: #fff; border-color: #fff; color: var(--jb-ink); }
  .jb-feature .jb-button:hover { background: var(--jb-brand); border-color: var(--jb-brand); color: #fff; }
  @media (min-width: 990px) {
    .jb-feature { grid-template-columns: 1fr 1fr; background: var(--jb-ivory); color: var(--jb-ink); }
    .jb-feature__media { grid-area: auto; min-height: 0; aspect-ratio: 4 / 5; max-height: 760px; width: 100%; }
    .jb-feature__body { grid-area: auto; align-self: center; gap: 18px; max-width: 560px; padding: 48px 64px; background: none; }
    .jb-feature .jb-eyebrow { color: var(--jb-brand); }
    .jb-feature .jb-eyebrow::before { background: var(--jb-brand); }
    .jb-feature__title { font-size: 48px; }
    .jb-feature__text { font-size: 16px; opacity: 1; }
    .jb-feature .jb-button { background: var(--jb-ink); border-color: var(--jb-ink); color: #fff; }
  }
</style>

{% schema %}
{
  "name": "Brand story",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "collection", "id": "collection", "label": "Fallback collection", "info": "Its first product image is used when no image is picked." },
    { "type": "text", "id": "eyebrow", "label": "Small line above the heading", "default": "MADE IN EGYPT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "بين الذوق والالتزام.. تبدأ أناقتك مع جنتان" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "اكتشفي منتجاتنا" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [
    { "name": "Brand story" }
  ]
}
{% endschema %}
