{%- comment -%}
  A lookbook mosaic: one large photograph and two smaller ones, each a product from the
  chosen collection with its name and price on the image.
{%- endcomment -%}

{%- assign look_collection = section.settings.collection -%}

{%- if look_collection != blank and look_collection.products_count > 0 -%}
<div class="hdt-container" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="jb-heading">
    {%- if section.settings.eyebrow != blank -%}<p class="jb-eyebrow" dir="ltr">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="jb-heading__title">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="jb-heading__sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>

  <ul class="jb-look" role="list">
    {%- assign look_shown = 0 -%}
    {%- for product in look_collection.products limit: 12 offset: section.settings.offset -%}
      {%- if product.featured_image == blank or product.available == false -%}{%- continue -%}{%- endif -%}
      {%- if look_shown == 3 -%}{%- break -%}{%- endif -%}
      {%- assign look_shown = look_shown | plus: 1 -%}
      <li class="jb-look__item">
        <a class="jb-look__card" href="{{ product.url }}">
          {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 50vw, 100vw', widths: '360, 480, 720, 960, 1200', alt: '' }}
          <span class="jb-look__text">
            <span class="jb-look__title">{{ product.title }}</span>
            <span class="jb-look__price">{{ product.price | money }}</span>
            <span class="jb-look__link">تسوّقي الإطلالة</span>
          </span>
        </a>
      </li>
    {%- endfor -%}
  </ul>

  {%- if section.settings.show_all -%}
    <p class="jb-look__all"><a class="jb-button jb-button--ghost" href="{{ look_collection.url }}">كل الإطلالات</a></p>
  {%- endif -%}
</div>

<style>
  .jb-look { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .jb-look__item:first-child { grid-column: 1 / -1; }
  .jb-look__card { position: relative; display: block; height: 100%; aspect-ratio: 2 / 3; overflow: hidden; border-radius: 4px; background: var(--jb-ivory); color: #fff; text-decoration: none; }
  .jb-look__item:first-child .jb-look__card { aspect-ratio: 4 / 5; }
  .jb-look__card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .7s ease; }
  .jb-look__card::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20, 12, 10, .8) 0%, rgba(20, 12, 10, .1) 45%, rgba(20, 12, 10, 0) 65%); }
  .jb-look__text { position: absolute; z-index: 1; inset-inline: 0; bottom: 0; display: grid; gap: 2px; justify-items: start; padding: 14px 12px; text-align: start; }
  .jb-look__title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 13px; font-weight: 600; line-height: 1.5; color: #fff; }
  .jb-look__price { font-size: 13px; color: #e9dfd3; }
  .jb-look__link { margin-top: 6px; font-size: 12px; font-weight: 600; color: #fff; border-bottom: 1px solid rgba(255, 255, 255, .7); padding-bottom: 1px; }
  .jb-look__item:first-child .jb-look__title { font-family: var(--jb-display); font-size: 24px; font-weight: 700; line-height: 1.35; }
  .jb-look__item:first-child .jb-look__text { padding: 20px 16px; }
  .jb-look__card:hover img { transform: scale(1.04); }
  .jb-look__card:focus-visible { outline: 2px solid var(--jb-brand); outline-offset: 3px; }
  .jb-look__all { margin: 24px 0 0; text-align: center; }
  @media (min-width: 768px) {
    .jb-look { grid-template-columns: 2fr 1fr 1fr; gap: 20px; }
    .jb-look__item:first-child { grid-column: auto; }
    .jb-look__card, .jb-look__item:first-child .jb-look__card { aspect-ratio: auto; min-height: 560px; }
    .jb-look__title { font-size: 15px; }
    .jb-look__item:first-child .jb-look__title { font-size: 34px; }
    .jb-look__item:first-child .jb-look__text { padding: 32px 28px; }
    .jb-look__text { padding: 20px 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .jb-look__card img { transition: none; } }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Lookbook",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "offset", "label": "Skip the first products", "min": 0, "max": 12, "step": 1, "default": 0 },
    { "type": "text", "id": "eyebrow", "label": "Small line above the heading", "default": "THE LOOKBOOK" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "تسوّقي الإطلالة" },
    { "type": "text", "id": "subheading", "label": "Line under the heading" },
    { "type": "checkbox", "id": "show_all", "label": "Show the 'all looks' button", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [
    { "name": "Lookbook" }
  ]
}
{% endschema %}
