{%- comment -%}
  A collection shown as one horizontal scroll strip of product cards.
{%- endcomment -%}

{%- liquid
  assign strip_collection = section.settings.collection
  assign strip_limit = section.settings.limit
-%}

{%- if strip_collection != blank and strip_collection.products_count > 0 -%}
{%- render 'jb-strip-assets' -%}
<div class="hdt-container" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <jb-strip class="jb-strip">
    <div class="jb-strip__head">
      <h2 class="jb-strip__heading">{{ section.settings.heading | default: strip_collection.title }}</h2>
      <div class="jb-strip__tools">
        {%- if section.settings.show_all -%}<a class="jb-strip__all" href="{{ strip_collection.url }}">عرض الكل</a>{%- endif -%}
        <button type="button" dir="ltr" class="jb-strip__arrow" data-strip="prev" aria-label="السابق">&#8250;</button>
        <button type="button" dir="ltr" class="jb-strip__arrow" data-strip="next" aria-label="التالي">&#8249;</button>
      </div>
    </div>

    <ul class="jb-strip__track" role="list">
      {%- for product in strip_collection.products limit: strip_limit -%}
        <li class="jb-strip__item">
          <a class="jb-pcard" href="{{ product.url }}">
            <span class="jb-pcard__media">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 23vw, 44vw', widths: '240, 360, 480, 600', alt: product.title }}
              {%- endif -%}
              {%- if product.available == false -%}
                <span class="jb-pcard__tag" style="background:#3a3b3d">نفذت الكمية</span>
              {%- elsif product.compare_at_price > product.price -%}
                {%- assign strip_saving = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price -%}
                <span class="jb-pcard__tag">خصم {{ strip_saving }}%</span>
              {%- endif -%}
            </span>
            <span class="jb-pcard__title">{{ product.title }}</span>
            {%- render 'card-price', product: product, price_class: 'hdt-text-base hdt-font-semibold' -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </jb-strip>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Product strip",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the collection title." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 4, "max": 20, "step": 1, "default": 10 },
    { "type": "checkbox", "id": "show_all", "label": "Show the 'view all' link", "default": true },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 }
  ],
  "presets": [
    { "name": "Product strip" }
  ]
}
{% endschema %}
