{%- comment -%}
  The store's categories shown as one horizontal scroll strip of round tiles.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
{%- render 'jb-strip-assets' -%}
<div class="hdt-container" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <jb-strip class="jb-strip jb-strip--categories">
    <div class="jb-strip__head">
      <h2 class="jb-strip__heading">{{ section.settings.heading }}</h2>
      <div class="jb-strip__tools">
        <button type="button" dir="ltr" class="jb-strip__arrow" data-strip="prev" aria-label="السابق">&#8250;</button>
        <button type="button" dir="ltr" class="jb-strip__arrow" data-strip="next" aria-label="التالي">&#8249;</button>
      </div>
    </div>

    <ul class="jb-strip__track" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_collection = block.settings.collection
          if tile_collection == blank or tile_collection.products_count == 0
            continue
          endif
          assign tile_image = block.settings.image | default: tile_collection.featured_image | default: tile_collection.products.first.featured_image
        -%}
        <li class="jb-strip__item" {{ block.shopify_attributes }}>
          <a class="jb-ccard" href="{{ tile_collection.url }}">
            <span class="jb-ccard__media">
              {%- if tile_image -%}
                {{ tile_image | image_url: width: 400 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 15vw, 30vw', widths: '160, 240, 320, 400', alt: '' }}
              {%- endif -%}
            </span>
            <span class="jb-ccard__title">{{ block.settings.title | default: tile_collection.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </jb-strip>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Category strip",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "تسوّقي حسب الفئة" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 16 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the collection image." }
      ]
    }
  ],
  "presets": [
    { "name": "Category strip" }
  ]
}
{% endschema %}
