{%- comment -%}
  The store's main categories as tall image tiles with the category name on the image.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
<div class="hdt-container" style="padding-top:{{ section.settings.padding_top }}px;padding-bottom:{{ section.settings.padding_bottom }}px">
  <div class="jb-tiles">
    <div class="jb-heading">
      {%- if section.settings.eyebrow != blank -%}<p class="jb-eyebrow" dir="ltr">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="jb-heading__title">{{ section.settings.heading }}</h2>
    </div>

    <ul class="jb-tiles__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_collection = block.settings.collection
          if tile_collection == blank or tile_collection.products_count == 0
            continue
          endif
          assign tile_image = block.settings.image | default: block.settings.product.featured_image | default: tile_collection.featured_image | default: tile_collection.products.first.featured_image
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="jb-tile" href="{{ tile_collection.url }}">
            {%- if tile_image -%}
              {{ tile_image | image_url: width: 800 | image_tag: loading: 'lazy', sizes: '(min-width: 768px) 25vw, 50vw', widths: '240, 360, 480, 640, 800', alt: '' }}
            {%- endif -%}
            <span class="jb-tile__text">
              <span class="jb-tile__title">{{ block.settings.title | default: tile_collection.title }}</span>
              <span class="jb-tile__link">تسوّقي الآن</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  .jb-tiles__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; margin: 0; padding: 0; list-style: none; }
  .jb-tile { position: relative; display: block; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 4px; background: var(--jb-ivory); color: #fff; text-decoration: none; }
  .jb-tile img { width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; transition: transform .7s ease; }
  .jb-tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20, 12, 10, .78) 0%, rgba(20, 12, 10, .12) 48%, rgba(20, 12, 10, 0) 70%); }
  .jb-tile__text { position: absolute; z-index: 1; inset-inline: 0; bottom: 0; display: grid; gap: 4px; padding: 16px 14px; text-align: center; }
  .jb-tile__title { font-family: var(--jb-display); font-size: 26px; font-weight: 700; line-height: 1.2; color: #fff; }
  .jb-tile__link { justify-self: center; font-size: 12px; font-weight: 600; color: #fff; border-bottom: 1px solid rgba(255, 255, 255, .7); padding-bottom: 1px; }
  .jb-tile:hover img { transform: scale(1.05); }
  .jb-tile:focus-visible { outline: 2px solid var(--jb-brand); outline-offset: 3px; }
  @media (min-width: 768px) {
    .jb-tiles__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
    .jb-tile__title { font-size: 32px; }
    .jb-tile__text { padding: 24px 16px; }
  }
  @media (prefers-reduced-motion: reduce) { .jb-tile img { transition: none; } }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Category tiles",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above the heading", "default": "THE COLLECTIONS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "تسوّقي حسب الفئة" },
    { "type": "range", "id": "padding_top", "label": "Top spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom spacing", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 24 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the product or collection image." },
        { "type": "product", "id": "product", "label": "Product photo", "info": "Its main photo is used when no image is picked." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "Category tiles" }
  ]
}
{% endschema %}
